# Etherscan V2 API key. Never commit real credentials.
ETHERSCAN_API_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# preview: never executes; app: only asks for Binance app confirmation; auto: executes verified previews
SNIPER_MODE=preview
SNIPER_INTERVAL_SECONDS=120
# app/auto also require executionEnabled=true in config.json.
ENABLE_EXECUTE=NO
